---
import Tone from './Tone.astro';
import { moreWork } from '../content/projects';
---

<section class="more experience-only" id="more-work" data-beat="stream" data-label="More work" data-group="Work" aria-labelledby="more-title">
  <div class="more-inner">
    <h2 id="more-title">
      <Tone text={{ immersive: 'A few more.', casual: 'A few more things I made.', recruiter: 'More projects' }} />
    </h2>
    <p class="hint">Hover a card to draw it.</p>
    <ul class="cards">
      {
        moreWork.map((p) => (
          <li class="card" data-override={p.slug} tabindex="-1">
            <h3>{p.name}</h3>
            <p class="tagline">{p.tagline}</p>
            {p.stats[0] && (
              <p class="stat">
                <span class="value">{p.stats[0].value}</span> <span class="label">{p.stats[0].label}</span>
              </p>
            )}
            <p class="tags">{p.tags.join(' · ')}</p>
            {p.links.map((l) => (
              <a class="link" href={l.href} target="_blank" rel="noopener">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .more {
    position: relative;
    z-index: 1;
    min-height: 130vh;
    display: flex;
    align-items: center;
    padding: 12vh var(--gutter);
  }
  .more-inner {
    width: min(48vw, 640px);
  }
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.4rem, 1.4rem + 3vw, 4.4rem);
    line-height: 1;
  }
  .hint {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .cards {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .card {
    position: relative;
    padding: 24px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.4s var(--ease-out);
  }
  .card:hover,
  .card:focus-within {
    background: color-mix(in srgb, var(--fg) 6%, var(--bg));
  }
  h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 2.1rem;
    line-height: 1;
  }
  .tagline {
    margin: 8px 0 0;
    color: var(--fg);
  }
  .stat {
    margin: 14px 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .stat .value {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.9rem;
  }
  .stat .label,
  .tags {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .tags {
    margin: 12px 0 0;
  }
  .link {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-decoration: none;
    border-bottom: 1px solid var(--fg-faint);
  }
  .link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  @media (max-aspect-ratio: 23/20) {
    .more-inner {
      width: 100%;
    }
    .hint {
      display: none;
    }
  }
</style>
