---
/**
 * The demo player dialog, shared by the résumé and the case studies. Any
 * `<a data-demo-open href=clip.mp4 data-title data-captions data-poster>` opens it
 * (see scripts/player.ts); the links stay plain links without JavaScript.
 */
---

<dialog class="player" data-player aria-label="Project demo">
  <div class="player-frame">
    <video muted loop playsinline preload="none"></video>
    <button type="button" class="player-close" data-player-close aria-label="Close the demo">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg>
    </button>
  </div>
  <div class="player-meta">
    <p class="player-title" data-player-title></p>
    <p class="player-caption" data-player-caption aria-live="polite"></p>
    <span class="player-track" aria-hidden="true"><i data-player-fill></i></span>
  </div>
</dialog>

<style>
  /* The demo player: a dark screening room over the page. */
  .player {
    width: min(1100px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: 18px;
    background: #0b0b0d;
    color: #f2f3f5;
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }
  .player::backdrop {
    background: rgba(8, 8, 10, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .player[open] {
    animation: player-in 0.45s var(--ease-out);
  }
  @keyframes player-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
  }
  .player-frame {
    position: relative;
  }
  .player video {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 150px);
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: #000;
    cursor: pointer;
  }
  .player-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: rgba(11, 11, 13, 0.7);
    color: #f2f3f5;
    cursor: pointer;
  }
  .player-close svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .player-close:hover {
    border-color: #f2f3f5;
  }
  .player-close:focus-visible {
    outline: 2px solid #f2f3f5;
    outline-offset: 2px;
  }
  .player-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 6px 18px;
    padding: 16px 22px 18px;
  }
  .player-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8b8e96;
  }
  .player-caption {
    margin: 0;
    min-height: 1.4em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.1rem, 0.9rem + 0.6vw, 1.45rem);
    line-height: 1.25;
  }
  .player-track {
    grid-column: 1 / -1;
    height: 1px;
    margin-top: 8px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }
  .player-track i {
    display: block;
    height: 100%;
    background: #f2f3f5;
    transform-origin: 0 0;
    transform: scaleX(0);
  }
  @media (max-width: 640px) {
    .player-meta {
      grid-template-columns: 1fr;
      padding: 14px 16px 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .player[open] {
      animation: none;
    }
  }
  @media print {
    .player {
      display: none;
    }
  }
</style>
