---
import Tone from './Tone.astro';
import { featured } from '../content/projects';
import { demoFor } from '../lib/demos';

const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(featured.length);
---

<section class="work experience-only" id="work" aria-labelledby="work-title">
  <header class="work-intro">
    <div class="work-intro-sticky">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-title">
        <Tone
          text={{
            immersive: 'Systems, drawn in light.',
            casual: 'Stuff I built and am proud of.',
            recruiter: 'Projects',
          }}
        />
      </h2>
      <p class="count">{total} projects · keep scrolling</p>
    </div>
  </header>

  {
    featured.map((p, i) => {
      const demo = demoFor(p);
      return (
      <article
        class:list={['chapter', i % 2 === 0 ? 'text-left' : 'text-right']}
        data-beat={p.slug}
        data-side={i % 2 === 0 ? 'right' : 'left'}
        data-label={p.name}
        data-group="Work"
        aria-labelledby={`p-${p.slug}`}
      >
        <div class="chapter-sticky">
          <div class="panel">
            <p class="index" aria-hidden="true">
              <span>{pad(i + 1)}</span>
              <span class="rule" />
              <span class="total">{total}</span>
            </p>
            {p.role && <p class="role">{p.role}</p>}
            <h3 id={`p-${p.slug}`} class="name">
              {p.name}
            </h3>
            <p class="tagline">{p.tagline}</p>
            <p class="summary">{p.summary}</p>
            <ul class="stats">
              {p.stats.map((s) => (
                <li>
                  <span class="value">{s.value}</span>
                  <span class="label">{s.label}</span>
                </li>
              ))}
            </ul>
            <ul class="stack" aria-label="Built with">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            {(p.links.length > 0 || demo) && (
              <p class="actions">
                {demo && (
                  <button
                    type="button"
                    class="pill demo-btn"
                    data-demo={p.slug}
                    data-src={demo.src}
                    data-captions={demo.captions}
                    data-side={i % 2 === 0 ? 'right' : 'left'}
                    aria-pressed="false"
                  >
                    <span class="when-off">▶ Demo</span>
                    <span class="when-on">◼ Shape</span>
                  </button>
                )}
                {p.links.map((l) => (
                  <a class="pill" href={l.href} target="_blank" rel="noopener">
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </p>
            )}
            {demo && (
              <video class="inline-demo" data-inline-demo={p.slug} poster={demo.poster || undefined} muted loop playsinline preload="none" hidden />
              <p class="inline-caption" data-inline-caption={p.slug} aria-live="polite" />
            )}
          </div>
        </div>
      </article>
      );
    })
  }
</section>

<style>
  .work {
    position: relative;
    z-index: 1;
  }

  .work-intro {
    height: 160vh;
  }
  .work-intro-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    align-content: end;
    justify-items: center;
    gap: 10px;
    padding: 0 var(--gutter) 18vh;
    text-align: center;
  }
  .eyebrow,
  .count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .work-intro h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--fg);
  }

  .chapter {
    height: 140vh;
  }
  .chapter-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .text-right .chapter-sticky {
    justify-content: flex-end;
  }

  .panel {
    width: min(44vw, 560px);
  }
  .panel > * {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out),
      filter 0.9s var(--ease-out);
  }
  .chapter:global(.is-active) .panel > * {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .chapter:global(.is-active) .panel > :nth-child(2) { transition-delay: 0.05s; }
  .chapter:global(.is-active) .panel > :nth-child(3) { transition-delay: 0.1s; }
  .chapter:global(.is-active) .panel > :nth-child(4) { transition-delay: 0.15s; }
  .chapter:global(.is-active) .panel > :nth-child(5) { transition-delay: 0.2s; }
  .chapter:global(.is-active) .panel > :nth-child(6) { transition-delay: 0.25s; }
  .chapter:global(.is-active) .panel > :nth-child(n + 7) { transition-delay: 0.3s; }

  .index {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--fg);
  }
  .index .rule {
    flex: 0 0 64px;
    height: 1px;
    background: var(--line);
  }
  .index .total {
    color: var(--fg-faint);
  }
  .role {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .name {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(3.4rem, 1.6rem + 5vw, 7.5rem);
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: var(--fg);
  }
  .tagline {
    margin: 14px 0 0;
    max-width: 34ch;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .summary {
    margin: 14px 0 0;
    max-width: 50ch;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--fg-dim);
  }

  .stats {
    list-style: none;
    margin: 26px 0 0;
    padding: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .stats li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding-right: 16px;
  }
  .stats li + li {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }
  .stats .value {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2rem, 1.3rem + 1.6vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .stats .label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .stack {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .stack li {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
  }

  .actions {
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-decoration: none;
    color: var(--fg);
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .pill:hover,
  .pill:focus-visible {
    background: var(--fg);
    color: var(--bg);
  }
  .demo-btn {
    cursor: pointer;
    background: none;
  }
  .demo-btn .when-on,
  .demo-btn[aria-pressed='true'] .when-off {
    display: none;
  }
  .demo-btn[aria-pressed='true'] .when-on {
    display: inline;
  }
  .inline-demo {
    display: block;
    width: 100%;
    margin-top: 16px;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-raised);
  }
  .inline-caption {
    margin: 8px 0 0;
    min-height: 1.3em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--fg);
  }
  .inline-caption:empty {
    display: none;
  }

  /* While a demo has the stage, the story steps back to name, numbers and controls. */
  .panel {
    transition: width 0.8s var(--ease-out);
  }
  .chapter:global(.is-demo) .panel {
    width: min(30vw, 400px);
  }
  .summary,
  .stack,
  .tagline {
    transition:
      opacity 0.5s var(--ease-out),
      max-height 0.8s var(--ease-out),
      margin 0.8s var(--ease-out);
    max-height: 20em;
  }
  .chapter:global(.is-demo) .summary,
  .chapter:global(.is-demo) .stack {
    opacity: 0;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
  }
  .chapter:global(.is-demo) .stats {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .chapter:global(.is-demo) .stats li + li {
    padding-left: 0;
    border-left: 0;
  }
  .inline-demo[hidden] {
    display: none;
  }

  /* Tall screens: the shape floats in the top half, the story sits below it. */
  @media (max-aspect-ratio: 23/20) {
    .chapter-sticky,
    .text-right .chapter-sticky {
      align-items: flex-end;
      justify-content: flex-start;
      padding-bottom: 5vh;
    }
    .panel {
      width: 100%;
    }
    .name {
      font-size: clamp(2.8rem, 1.8rem + 6vw, 4.6rem);
    }
    .summary {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 0.94rem;
    }
    .stats {
      margin-top: 16px;
      padding-top: 12px;
    }
    .stats .value {
      font-size: 1.7rem;
    }
    .stack {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel > * {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>
