---
import Tone from './Tone.astro';
import { projects } from '../content/projects';

const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(projects.length);
---

<section class="work experience-only" id="work" aria-labelledby="work-title">
  <header class="work-intro">
    <div class="work-intro-sticky">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-title">
        <Tone
          text={{
            immersive: 'Systems, drawn in light.',
            casual: 'Stuff I built and am proud of.',
            recruiter: 'Projects',
          }}
        />
      </h2>
      <p class="count">{total} projects · keep scrolling</p>
    </div>
  </header>

  <div class="chapters" data-chapters>
    {
      projects.map((p, i) => (
        <article class:list={['chapter', i % 2 === 0 ? 'text-left' : 'text-right']} data-chapter={p.slug} aria-labelledby={`p-${p.slug}`}>
          <div class="chapter-sticky">
            <div class="panel">
              <p class="index">
                {pad(i + 1)} <span>/ {total}</span>
              </p>
              <h3 id={`p-${p.slug}`}>{p.name}</h3>
              <p class="tagline">{p.tagline}</p>
              {p.role && <p class="role">{p.role}</p>}
              <p class="summary">{p.summary}</p>
              <ul class="metrics">
                {p.metrics.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
              <ul class="tags" aria-label="Built with">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              {p.links.length > 0 && (
                <p class="links">
                  {p.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener">
                      {l.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .work {
    position: relative;
    z-index: 1;
  }

  .work-intro {
    height: 160vh;
  }
  .work-intro-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    align-content: end;
    justify-items: center;
    gap: 10px;
    padding: 0 var(--gutter) 18vh;
    text-align: center;
  }
  .eyebrow,
  .count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .work-intro h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--fg);
  }

  .chapter {
    height: 160vh;
  }
  .chapter-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .text-right .chapter-sticky {
    justify-content: flex-end;
  }

  .panel {
    width: min(44vw, 540px);
  }
  .panel > * {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out),
      filter 0.9s var(--ease-out);
  }
  .chapter:global(.is-active) .panel > * {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .chapter:global(.is-active) .panel > :nth-child(2) { transition-delay: 0.05s; }
  .chapter:global(.is-active) .panel > :nth-child(3) { transition-delay: 0.1s; }
  .chapter:global(.is-active) .panel > :nth-child(4) { transition-delay: 0.15s; }
  .chapter:global(.is-active) .panel > :nth-child(5) { transition-delay: 0.2s; }
  .chapter:global(.is-active) .panel > :nth-child(6) { transition-delay: 0.25s; }
  .chapter:global(.is-active) .panel > :nth-child(n + 7) { transition-delay: 0.3s; }

  .index {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--fg);
  }
  .index span {
    color: var(--fg-faint);
  }
  h3 {
    margin: 0;
    font-size: clamp(2.6rem, 1.4rem + 4.2vw, 5.6rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
  }
  .tagline {
    margin: 12px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--fg);
  }
  .role {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg);
  }
  .role::before {
    content: '◆ ';
    color: var(--fg-faint);
  }
  .summary {
    margin: 16px 0 0;
    max-width: 46ch;
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--fg-dim);
  }
  .metrics {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .metrics li {
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg);
  }
  .tags {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .links {
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .links a {
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--fg-faint);
    transition: border-color 0.3s var(--ease-out);
  }
  .links a:hover {
    border-color: var(--fg);
  }

  /* Tall screens: the shape floats in the top half, the story sits below it. */
  @media (max-aspect-ratio: 23/20) {
    .chapter-sticky,
    .text-right .chapter-sticky {
      align-items: flex-end;
      justify-content: flex-start;
      padding-bottom: 6vh;
    }
    .panel {
      width: 100%;
    }
    .summary {
      display: none;
    }
    h3 {
      font-size: clamp(2.4rem, 1.6rem + 6vw, 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel > * {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>
