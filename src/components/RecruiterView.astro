---
import { resume, skillUses } from '../content/resume';
import '../styles/build.css';
import DemoPlayer from './DemoPlayer.astro';
import { formatDate, getPosts } from '../lib/writing';
import { demoFor, thumbFor } from '../lib/demos';
import { caseStudies } from '../lib/work';

interface Props {
  /** On /resume the page is only this view, so the way out is a link rather than a mode switch. */
  standalone?: boolean;
}
const { standalone = false } = Astro.props;

const work = resume.work;
const education = resume.education;
const projects = resume.projects;
/** The first three get a wide card with a still from their demo. */
const LEADS = 3;
const merged = resume.openSource.merged;
const newestFirst = [...merged].sort((a, b) => b.mergedAt.localeCompare(a.mergedAt));
/** The sidebar shows the newest few; the rest are a click away (all of them print). */
const PRS_SHOWN = 6;
const posts = (await getPosts()).slice(0, 3);
const studies = await caseStudies();

/** Bold the numbers in a line so a skim catches the impact (escapes HTML first). */
const emphasize = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(
      /(?<![A-Za-z\d\-])([~−]?\$?\d[\d,.]*(?:[–-]\d[\d,.]*)?(?:\s?(?:%|ms|µs|ns|k\+?|M|×|\+))?(?:\s?(?:req|writes|items)\/s(?:ec)?)?)(?![A-Za-z\d])/g,
      '<strong>$1</strong>',
    );

const glance = resume.glance;
const { availability: av, timezone: tz } = resume;
const closeLine = `${av.start}: ${av.roles}, ${av.where.toLowerCase()} from ${resume.location.split(',')[0]} (${tz.label}). Email is the quickest way to reach me.`;
const snapshot = new Date(resume.openSource.snapshotAt).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Asia/Kolkata',
});
---

<article class="resume recruiter-only" aria-labelledby="resume-name" data-buildable>
  <p class="switch">
    The quick version.{' '}
    {
      standalone ? (
        <a href="/?view=immersive">See the full experience →</a>
      ) : (
        <button type="button" data-set-mode="immersive">See the full experience →</button>
      )
    }
  </p>

  <header class="card head">
    <div class="who">
      <img class="avatar" src="/portrait/ayush-avatar.png" alt={`Portrait of ${resume.name}`} width="96" height="96" />
      <p class="status"><span class="dot" aria-hidden="true"></span> Open to {resume.availability.roles}</p>
      <h1 id="resume-name">{resume.name}</h1>
      <p class="role">{resume.headline} <span class="stack">— {resume.stack.join(', ')}</span></p>
      <p class="where">
        {resume.location} · B.Tech ECE, {education[0]?.company}, graduating {resume.graduating}
      </p>
    </div>

    <div class="cta">
      <div class="mail">
        <a class="btn primary" href={`mailto:${resume.contact.email}`}>Email me</a>
        <button class="btn copy" type="button" data-copy={resume.contact.email} aria-label="Copy email address" title={resume.contact.email}>
          <svg class="idle" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6"></rect><path d="M10.5 5V3.6c0-.9-.7-1.6-1.6-1.6H3.6C2.7 2 2 2.7 2 3.6v5.3c0 .9.7 1.6 1.6 1.6H5"></path></svg>
          <svg class="done" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8.6l3 3 6.6-7"></path></svg>
        </button>
      </div>
      <a class="btn pdf" href={resume.pdf} target="_blank" rel="noopener">Résumé PDF ↗</a>
      <a class="btn" href={resume.contact.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a class="btn" href={resume.contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </div>

    <dl class="facts">
      <div>
        <dt>Looking for</dt>
        <dd>{resume.availability.roles}</dd>
      </div>
      <div>
        <dt>Where</dt>
        <dd>{resume.availability.where} · {resume.timezone.label} ({resume.timezone.offset})</dd>
      </div>
      <div>
        <dt>Start</dt>
        <dd>{resume.availability.start}</dd>
      </div>
      <div class="local">
        <dt>Local time</dt>
        <dd><span class="clock" data-local-time>{resume.timezone.offset}</span> in Naya Raipur</dd>
      </div>
    </dl>

    <p class="summary">{resume.summary}</p>

    <p class="print-contact">
      <a href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a>
      <a href={resume.contact.site}>{resume.contact.site.replace('https://', '')}</a>
      <a href={resume.contact.github}>{resume.contact.github.replace('https://', '')}</a>
      <a href={resume.contact.linkedin}>{resume.contact.linkedin.replace('https://', '')}</a>
    </p>
  </header>

  <nav class="toc" aria-label="Résumé sections" data-toc>
    <a href="#r-experience">Experience</a>
    <a href="#r-projects">Projects</a>
    <a href="#r-skills">Skills</a>
    <a href="#r-open-source">Open source</a>
    <a href="#r-contact">Contact</a>
  </nav>

  <ul class="glance" aria-label="At a glance">
    {
      glance.map((g) => (
        <li>
          <span class="value">{g.value}</span>
          <span class="label">{g.label}</span>
        </li>
      ))
    }
  </ul>

  <div class="grid">
    <div class="main">
      <section id="r-experience" class="anchor" aria-labelledby="exp-h">
        <h2 id="exp-h">Experience</h2>
        <ol class="timeline">
          {
            work.map((r) => (
              <li class="role-item" data-trace={`role-${r.id}`}>
                <div class="role-head">
                  <h3>
                    {r.logo && <img class="logo" src={r.logo} alt="" width="96" height="96" loading="lazy" decoding="async" />}
                    {r.company} <span class="title">· {r.title}</span>
                  </h3>
                  <span class="when">{r.period}</span>
                </div>
                {r.product && <p class="product">{r.product}</p>}
                <p class="impact">{r.summary}</p>
                <ul class="points">
                  {r.points.map((pt) => (
                    <li set:html={emphasize(pt)} />
                  ))}
                </ul>
                {r.stack && (
                  <ul class="role-stack" aria-label={`${r.company} stack`}>
                    {r.stack.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <section id="r-projects" class="anchor" aria-labelledby="proj-h">
        <h2 id="proj-h">Projects</h2>
        <ul class="projects">
          {
            projects.map((p, i) => {
              const lead = i < LEADS && thumbFor(p);
              return (
                <li class:list={['project', p.tier === 'featured' && 'featured', lead && 'lead']} data-trace={`project-${p.slug}`}>
                  {lead && (
                    <a
                      class="shot"
                      href={demoFor(p)?.src ?? thumbFor(p)}
                      data-demo-open={demoFor(p) ? '' : undefined}
                      data-title={p.name}
                      data-poster={demoFor(p)?.poster}
                      data-captions={demoFor(p)?.captions}
                      aria-label={demoFor(p) ? `Play the ${p.name} demo` : undefined}
                    >
                      <img src={thumbFor(p)} alt={`${p.name}, from its demo`} width="800" height="500" loading="lazy" decoding="async" />
                      {demoFor(p) && (
                        <span class="play" aria-hidden="true">
                          <svg viewBox="0 0 16 16"><path d="M5 3.2v9.6L12.6 8z" /></svg>
                        </span>
                      )}
                    </a>
                  )}
                  <div class="body">
                    <div class="project-head">
                      <h3>{p.name}</h3>
                      {p.role && <span class="badge">{p.role.split(' — ')[0]}</span>}
                    </div>
                    <p class="tagline">{p.tagline}</p>
                    <ul class="stats">
                      {p.stats.slice(0, 3).map((s) => (
                        <li>
                          <strong>{s.value}</strong> {s.label}
                        </li>
                      ))}
                    </ul>
                    <p class="tags">{p.tags.join(' · ')}</p>
                    {(p.links.length > 0 || demoFor(p) || studies.has(p.slug)) && (
                      <p class="links">
                        {studies.has(p.slug) && <a class="study" href={`/work/${p.slug}/`}>Case study →</a>}
                        {p.links.map((l) => (
                          <a href={l.href} target="_blank" rel="noopener">
                            {l.label} ↗
                          </a>
                        ))}
                        {demoFor(p) && (
                          <a
                            class="demo-link"
                            href={demoFor(p)!.src}
                            data-demo-open
                            data-title={p.name}
                            data-poster={demoFor(p)!.poster}
                            data-captions={demoFor(p)!.captions}
                          >
                            ▶ Demo
                          </a>
                        )}
                      </p>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ul>
      </section>
    </div>

    <aside class="side">
      <section id="r-skills" class="card skills anchor" aria-labelledby="skills-h">
        <h2 id="skills-h">Skills</h2>
        <p class="trace-hint"><span class="on-hover">Point at</span><span class="on-touch">Tap</span> a skill to see where I used it.</p>
        {
          Object.entries(resume.skills).map(([group, list]) => (
            <div class="skill-group">
              <h3>{group}</h3>
              <ul class="chips">
                {list.map((s) => {
                  const hits = skillUses[s] ?? [];
                  return hits.length ? (
                    <li>
                      <button
                        type="button"
                        class="chip-trace"
                        data-hits={hits.join(' ')}
                        aria-pressed="false"
                        aria-label={`${s}, used in ${hits.length} ${hits.length === 1 ? 'place' : 'places'} on this page`}
                      >
                        {s}
                        <span class="hits" aria-hidden="true">{hits.length}</span>
                      </button>
                    </li>
                  ) : (
                    <li>{s}</li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </section>

      <section id="r-open-source" class="card oss anchor" aria-labelledby="oss-h">
        <h2 id="oss-h">Open source</h2>
        <p class="oss-sum">
          <strong>{merged.length}</strong> merged · <strong>{resume.openSource.openCount}</strong> in review
        </p>
        <ul class="prs" id="oss-prs" data-shown={PRS_SHOWN}>
          {
            newestFirst.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener">
                  <span class="repo">
                    {p.repo}#{p.number}
                  </span>
                  <span class="pr-title">{p.title}</span>
                  <span class="diff">
                    +{p.additions} −{p.deletions} · merged {p.mergedAt.slice(0, 10)}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          merged.length > PRS_SHOWN && (
            <button type="button" class="more-prs" aria-controls="oss-prs" aria-expanded="false" data-more-prs>
              Show all {merged.length}
            </button>
          )
        }
      </section>

      <section class="card edu-card" aria-labelledby="edu-h">
        <h2 id="edu-h">Education</h2>
        {
          education.map((r) => (
            <div class="edu">
              <h3>
                {r.logo && <img class="logo" src={r.logo} alt="" width="96" height="96" loading="lazy" decoding="async" />}
                {r.company}
              </h3>
              <p>{r.title}</p>
              <p class="when">{r.period}</p>
              {r.product && <p class="note">{r.product}</p>}
            </div>
          ))
        }
      </section>

      {
        posts.length > 0 && (
          <section class="card writing" aria-labelledby="writing-h">
            <h2 id="writing-h">Writing</h2>
            <ul class="prs">
              {posts.map((p) => (
                <li>
                  <a href={`/writing/${p.id}/`}>
                    <span class="pr-title">{p.data.title}</span>
                    <span class="diff">{formatDate(p.data.date)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>

  <footer id="r-contact" class="close anchor" aria-labelledby="close-h">
    <h2 id="close-h" class="close-title">Hiring for backend or systems work?</h2>
    <p class="close-lede">{closeLine}</p>
    <div class="close-cta">
      <div class="mail">
        <a class="btn primary" href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a>
        <button class="btn copy" type="button" data-copy={resume.contact.email} aria-label="Copy email address" title="Copy">
          <svg class="idle" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6"></rect><path d="M10.5 5V3.6c0-.9-.7-1.6-1.6-1.6H3.6C2.7 2 2 2.7 2 3.6v5.3c0 .9.7 1.6 1.6 1.6H5"></path></svg>
          <svg class="done" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8.6l3 3 6.6-7"></path></svg>
        </button>
      </div>
      <a class="btn" href={resume.pdf} target="_blank" rel="noopener">Résumé PDF ↗</a>
      <a class="btn" href={resume.contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </div>
    <p class="colophon">
      <span>Also as <a href="/resume.json">resume.json</a> · <a href="/llms.txt">llms.txt</a></span>
      <span>Numbers as of {snapshot}</span>
      <span>
        Built live by <a href="https://github.com/Ayushjo/MyOwnDevin" target="_blank" rel="noopener">Pullwright</a>'s agents ·
        press R · after Joel Califa's Swarm, as seen on{' '}
        <a href="https://www.beebombshell.com/resume" target="_blank" rel="noopener">Bhavya Verma's résumé</a>
      </span>
    </p>
  </footer>

  <div class="dock" data-dock aria-label="Contact">
    <a class="btn primary" href={`mailto:${resume.contact.email}`}>Email me</a>
    <button class="btn copy" type="button" data-copy={resume.contact.email} aria-label="Copy email address">
      <svg class="idle" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6"></rect><path d="M10.5 5V3.6c0-.9-.7-1.6-1.6-1.6H3.6C2.7 2 2 2.7 2 3.6v5.3c0 .9.7 1.6 1.6 1.6H5"></path></svg>
      <svg class="done" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8.6l3 3 6.6-7"></path></svg>
    </button>
    <a class="btn" href={resume.pdf} target="_blank" rel="noopener">PDF ↗</a>
  </div>

  <noscript><style>.prs li { display: block !important; } .more-prs { display: none; }</style></noscript>

  <DemoPlayer />
</article>

<style>
  .resume {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px var(--gutter) 96px;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .switch {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-dim);
  }
  .switch a,
  .switch button {
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--fg-faint);
    background: none;
    font: inherit;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg-raised);
  }

  .head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 26px 40px;
    padding: 36px;
  }
  .avatar {
    display: block;
    width: 96px;
    height: 96px;
    margin: 0 0 18px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line), 0 0 0 6px var(--bg);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
    padding: 5px 13px 5px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg);
  }
  .dot {
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2f9e5b;
  }
  /* A slow ring, like a status light: present without asking for attention. */
  .dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid #2f9e5b;
    opacity: 0;
    animation: ping 2.8s var(--ease-out) infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.8rem, 2rem + 3vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .role {
    margin: 12px 0 0;
    font-size: 1.12rem;
    font-weight: 500;
  }
  .role .stack {
    font-weight: 400;
    color: var(--fg-dim);
  }
  .where {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-dim);
  }
  .cta {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 210px;
  }
  .mail {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px;
  }
  .btn {
    display: block;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-align: center;
    text-decoration: none;
    color: var(--fg);
    background: none;
    transition:
      border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out);
  }
  .btn:hover {
    border-color: var(--fg);
  }
  .btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .btn.primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .copy {
    display: grid;
    place-items: center;
    width: 42px;
    padding: 0;
    cursor: pointer;
  }
  .copy svg {
    grid-area: 1 / 1;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.35s var(--ease-out);
  }
  .copy .done {
    stroke: #2f9e5b;
    stroke-width: 1.8;
    opacity: 0;
    transform: scale(0.6);
  }
  .copy:global(.is-copied) {
    border-color: #2f9e5b;
  }
  .copy:global(.is-copied) .idle {
    opacity: 0;
    transform: scale(0.6);
  }
  .copy:global(.is-copied) .done {
    opacity: 1;
    transform: none;
  }

  .facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts div {
    padding: 14px 18px;
    min-width: 0;
  }
  .facts div:first-child {
    padding-left: 0;
  }
  .facts div + div {
    border-left: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .facts dd {
    margin: 5px 0 0;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }
  .summary {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 72ch;
    color: var(--fg-dim);
    font-size: 1.04rem;
  }

  .glance {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    background: var(--line);
  }
  .glance li {
    display: grid;
    gap: 4px;
    padding: 20px 22px;
    background: var(--bg-raised);
  }
  .glance .value {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2.3rem;
    line-height: 1;
  }
  .glance .label {
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--fg-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 40px;
    margin-top: 44px;
    align-items: start;
  }
  .side {
    display: grid;
    gap: 16px;
    position: sticky;
    top: 84px;
  }
  .side .card {
    padding: 22px 24px;
  }

  h2 {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .main section + section {
    margin-top: 48px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .role-item {
    position: relative;
    padding: 0 0 30px 26px;
  }
  .role-item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 9px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fg);
  }
  .role-item:last-child {
    padding-bottom: 0;
  }
  .role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }
  .role-head h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
  }
  /* Company marks: white-on-black mattes, inverted and multiplied into ink on the paper. */
  .logo {
    display: inline-block;
    width: auto;
    height: 1.15em;
    max-width: 4.2em;
    margin: 0 0.32em 0 0;
    vertical-align: -0.16em;
    object-fit: contain;
    filter: invert(1) contrast(1.15);
    mix-blend-mode: multiply;
  }
  @media screen and (prefers-color-scheme: dark) {
    .logo {
      filter: contrast(1.1);
      mix-blend-mode: screen;
    }
  }
  .edu .logo {
    height: 1.5em;
    vertical-align: -0.4em;
    margin-right: 0.45em;
  }
  .role-head .title {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--fg-dim);
  }
  .when {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .product {
    margin: 2px 0 0;
    font-size: 0.9rem;
    color: var(--fg-dim);
  }
  .impact {
    margin: 10px 0 0;
    padding-left: 12px;
    border-left: 2px solid var(--fg);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.18rem;
    line-height: 1.3;
  }
  .role-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }
  .role-stack li {
    padding: 2px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-dim);
  }
  .points {
    margin: 12px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .points :global(strong),
  .stats strong {
    font-weight: 700;
    color: var(--fg);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .project {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
  }
  .project .body {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
  }
  /* Lead projects: a wide card with a still from the demo, greyscale until you look closer. */
  .project.lead {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
    align-items: center;
    gap: 22px;
    padding: 16px 22px 16px 16px;
  }
  .shot {
    position: relative;
    display: block;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #0b0b0d;
    aspect-ratio: 16 / 10;
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.12) brightness(1.12);
    transform: scale(1.02);
    transition:
      filter 0.7s var(--ease-out),
      transform 0.9s var(--ease-out);
  }
  .project.lead:hover .shot img,
  .project.lead:focus-within .shot img {
    filter: none;
    transform: scale(1);
  }
  /* No hover on touch screens: show the colour from the start. */
  @media (hover: none) {
    .shot img {
      filter: none;
      transform: none;
    }
  }
  .play {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(250, 250, 247, 0.92);
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s var(--ease-out);
  }
  .play svg {
    width: 14px;
    height: 14px;
    margin-left: 2px;
    fill: #111;
  }
  .shot:hover .play,
  .shot:focus-visible .play {
    transform: scale(1.1);
  }
  .shot:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
  }
  .project h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1;
  }
  .badge {
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--fg-dim);
  }
  .tagline {
    margin: 0;
    font-weight: 500;
    line-height: 1.4;
  }
  .stats {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    gap: 3px;
    font-size: 0.86rem;
    color: var(--fg-dim);
  }
  .tags {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-dim);
  }
  .links {
    margin: 2px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }
  .links a,
  .prs a {
    text-decoration: none;
  }
  .links a {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  /* The case study leads: it's where the depth is. */
  .links a.study {
    font-weight: 500;
    border-bottom-color: var(--fg);
  }
  /* Small text links keep their look but get a 24 px+ hit area (WCAG 2.2 target size). */
  .links a::after,
  .switch a::after,
  .switch button::after {
    content: '';
    position: absolute;
    inset: -7px -4px;
  }
  .switch a,
  .switch button {
    position: relative;
  }
  .links a:hover {
    border-color: var(--fg);
  }

  .skill-group + .skill-group {
    margin-top: 14px;
  }
  .skill-group h3,
  .edu h3 {
    margin: 0 0 6px;
    font-size: 0.86rem;
    font-weight: 600;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .chips li {
    padding: 2px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--fg-dim);
  }
  .chips li:has(.chip-trace) {
    padding: 0;
    border: 0;
  }
  .chip-trace {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 6px 2px 9px;
    border: 1px solid color-mix(in srgb, var(--fg) 26%, transparent);
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: 0.78rem;
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }
  .chip-trace .hits {
    min-width: 15px;
    padding: 0 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 9%, transparent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 15px;
    text-align: center;
  }
  .chip-trace:hover,
  .chip-trace:focus-visible,
  .chip-trace[aria-pressed='true'] {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
  .chip-trace:hover .hits,
  .chip-trace:focus-visible .hits,
  .chip-trace[aria-pressed='true'] .hits {
    background: color-mix(in srgb, var(--bg) 22%, transparent);
  }
  .chip-trace:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .trace-hint .on-touch {
    display: none;
  }
  @media (hover: none) {
    .trace-hint .on-hover {
      display: none;
    }
    .trace-hint .on-touch {
      display: inline;
    }
  }
  .trace-hint {
    margin: -8px 0 14px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-dim);
  }
  /* Tracing a skill: everything that didn't use it steps back. */
  [data-trace] {
    transition:
      opacity 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .resume:global(.is-tracing) [data-trace]:not(:global(.is-hit)) {
    opacity: 0.28;
  }
  .resume:global(.is-tracing) .project:global(.is-hit) {
    box-shadow: 0 0 0 1.5px var(--fg);
  }
  .oss-sum {
    margin: -8px 0 12px;
    font-size: 0.86rem;
    color: var(--fg-dim);
  }
  .oss-sum strong {
    color: var(--fg);
    font-weight: 600;
  }
  .prs[data-shown='6']:not(:global(.is-all)) li:nth-child(n + 7) {
    display: none;
  }
  .more-prs {
    margin-top: 10px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg);
    cursor: pointer;
  }
  .more-prs:hover {
    border-color: var(--fg);
  }
  .more-prs:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .prs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .prs a {
    display: grid;
    gap: 1px;
    padding: 9px 10px;
    margin: 0 -10px;
    border-radius: 10px;
    transition: background-color 0.2s var(--ease-out);
  }
  .prs a:hover {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }
  .repo,
  .diff {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-dim);
  }
  .pr-title {
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .note {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-dim);
  }
  .edu p {
    margin: 0;
    font-size: 0.88rem;
  }

  @media (max-width: 920px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .facts div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .facts div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
    .glance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .head {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .cta {
      grid-template-columns: 1fr 1fr;
    }
    .mail,
    .pdf {
      grid-column: 1 / -1;
    }

    .projects {
      grid-template-columns: 1fr;
    }
    .project.lead {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 14px 14px 20px;
    }
    .project.lead .body {
      padding: 0 6px;
    }
    .glance .value {
      font-size: 1.9rem;
    }
  }

  @media (max-width: 420px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts div,
    .facts div + div {
      padding-left: 0;
      border-left: 0;
    }
    .facts div + div {
      border-top: 1px solid var(--line);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot::after {
      animation: none;
    }
  }


  /* The close: one question, every way to answer it. */
  .close {
    margin-top: 72px;
    padding: 56px 0 8px;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .close-title {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.015em;
    text-transform: none;
    color: var(--fg);
  }
  .close-lede {
    max-width: 52ch;
    margin: 16px auto 0;
    color: var(--fg-dim);
  }
  .close-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }
  .close-cta .mail {
    display: grid;
    grid-template-columns: auto auto;
  }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    margin: 40px 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-dim);
  }
  .colophon a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .colophon a:hover {
    color: var(--fg);
  }
  @media (max-width: 640px) {
    .close-cta {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .close-cta .mail {
      grid-column: 1 / -1;
      grid-template-columns: 1fr auto;
    }
    .close-cta .btn.primary {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Section nav: a slim pill that slides in under the header once the top card is behind you. */
  .toc {
    position: fixed;
    top: 66px;
    left: 50%;
    z-index: 20;
    display: flex;
    gap: 2px;
    max-width: calc(100vw - 24px);
    padding: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-raised) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px -14px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -8px);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .toc::-webkit-scrollbar {
    display: none;
  }
  .toc:global(.is-shown),
  .toc:focus-within {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .toc a {
    flex: none;
    padding: 6px 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }
  .toc a:hover {
    color: var(--fg);
  }
  .toc a[aria-current='true'] {
    background: var(--fg);
    color: var(--bg);
  }
  .toc a:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 1px;
  }
  .anchor {
    scroll-margin-top: 120px;
  }
  @media (max-width: 560px) {
    .toc {
      top: 62px;
    }
    .toc a {
      padding: 6px 10px;
    }
  }

  /* Phones: once the top buttons scroll away, email and the PDF dock at the bottom. */
  .dock {
    display: none;
  }
  @media (max-width: 640px) {
    .dock {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 12px;
      z-index: 25;
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 6px;
      padding: 6px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 12px 30px -14px rgba(0, 0, 0, 0.35);
      opacity: 0;
      pointer-events: none;
      transform: translateY(calc(100% + 16px));
      transition:
        opacity 0.3s var(--ease-out),
        transform 0.45s var(--ease-out);
    }
    .dock:global(.is-shown) {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    .dock .btn {
      padding: 10px 14px;
    }
    .dock .copy {
      width: 42px;
    }
    /* Leave room so the dock never covers the last lines. */
    .resume {
      padding-bottom: 120px;
    }
  }

  .print-contact {
    display: none;
  }

  /* Print (and the generated PDF): one dense column on A4, plain contact lines, no chrome. */
  @page {
    size: A4;
    margin: 12mm 14mm 13mm;
  }
  @media print {
    :global(html),
    :global(body) {
      background: #fff !important;
    }
    .resume {
      max-width: none;
      padding: 0;
      font-size: 9.6pt;
      line-height: 1.42;
      color: #111;
    }
    /* Static and unspaced, so the PDF's text layer reads in page order with real word gaps
       (positioned boxes are written out of order; tight tracking swallows spaces). */
    .resume,
    .role-item,
    .timeline,
    .side {
      position: static !important;
    }
    h1,
    h3 {
      letter-spacing: 0 !important;
      word-spacing: 0.12em;
    }
    .switch,
    .cta,
    .toc,
    .dock,
    .close,
    .avatar,
    .status,
    .writing,
    .demo-link,
    .role-item::before {
      display: none !important;
    }
    .card,
    .project,
    .glance,
    .glance li {
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }
    .head {
      display: block;
      padding: 0;
    }
    h1 {
      font-size: 26pt;
    }
    .role {
      margin-top: 4pt;
      font-size: 11.5pt;
    }
    .where {
      margin-top: 2pt;
      font-size: 8pt;
    }
    .print-contact {
      display: flex;
      flex-wrap: wrap;
      gap: 0 14pt;
      margin: 6pt 0 0;
      font-family: var(--font-mono);
      font-size: 8pt;
    }
    .print-contact a {
      color: #111;
      text-decoration: none;
    }
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      margin-top: 9pt;
      border-color: #d4d4d4;
    }
    .facts .local {
      display: none;
    }
    .facts div {
      border-top: 0 !important;
    }
    .facts div + div {
      padding-left: 8pt !important;
      border-left: 1px solid #d4d4d4 !important;
    }
    .facts div:first-child {
      padding-left: 0 !important;
    }
    .facts div {
      padding: 4pt 8pt;
      border-color: #d4d4d4 !important;
    }
    .facts dt {
      font-size: 6.5pt;
    }
    .facts dd {
      margin-top: 1pt;
      font-size: 8.5pt;
    }
    .summary {
      margin-top: 8pt;
      max-width: none;
      font-size: 9.6pt;
      color: #333;
    }
    .glance {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      margin: 10pt 0 0;
      border-top: 1px solid #d4d4d4;
      border-bottom: 1px solid #d4d4d4;
    }
    .glance li {
      padding: 5pt 8pt;
      border-top: 0 !important;
    }
    .glance li:first-child {
      padding-left: 0;
    }
    .glance li + li {
      border-left: 1px solid #d4d4d4 !important;
    }
    .glance .value {
      font-size: 15pt;
    }
    .glance .label {
      font-size: 7pt;
    }
    .grid {
      display: block;
      margin-top: 12pt;
    }
    h2 {
      margin: 12pt 0 5pt !important;
      padding-bottom: 3pt;
      border-bottom: 1px solid #111;
      font-size: 7.5pt !important;
      color: #111 !important;
    }
    .main section + section {
      margin-top: 0;
    }
    .timeline {
      padding: 0;
      border: 0;
    }
    .role-item {
      padding: 0 0 7pt;
    }
    .role-head h3 {
      font-size: 11pt;
    }
    .when {
      font-size: 7.5pt;
    }
    .product {
      font-size: 8.5pt;
    }
    .impact {
      margin-top: 2pt;
      padding-left: 6pt;
      border-left-width: 1.5px;
      font-size: 9.5pt;
    }
    .role-stack {
      display: block;
      margin-top: 2pt;
    }
    .role-stack li {
      display: inline;
      padding: 0;
      border: 0;
      font-size: 7.5pt;
    }
    .role-stack li + li::before {
      content: ' · ';
    }
    .points {
      margin-top: 3pt;
      padding-left: 12pt;
    }
    .points li {
      margin: 1pt 0;
    }
    .projects {
      display: block;
    }
    .project,
    .project.lead,
    .project .body {
      display: block;
      padding: 0 0 5pt;
    }
    .shot {
      display: none;
    }
    .project-head {
      display: inline-flex;
      gap: 6pt;
      align-items: baseline;
    }
    .project h3 {
      font-size: 11pt;
    }
    .badge {
      padding: 0 5pt;
      border-color: #ccc;
      font-size: 6.5pt;
