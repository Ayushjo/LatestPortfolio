---
import Base from '../layouts/Base.astro';
import ModeSlider from '../components/ModeSlider.astro';
import RecruiterView from '../components/RecruiterView.astro';
import { profile } from '../content/profile';
---

<Base
  mode="recruiter"
  image="/og-resume-v2.png"
  imageAlt="Ayush Singh's résumé: backend and systems engineer, with a silver-particle portrait"
  title={`${profile.name} — Résumé`}
  description={`${profile.tagline.recruiter} ${profile.bio.recruiter}`}
>
  <header class="site-header">
    <nav class="nav" aria-label="Primary">
      <a class="mark" href="/?view=immersive" aria-label={`${profile.name} — home`}>AS<span>/</span>26</a>
      <a class="nav-link" href="/writing/">Writing</a>
    </nav>
    <ModeSlider />
  </header>
  <main>
    <RecruiterView standalone />
  </main>
</Base>

<script>
  import { initSlider } from '../scripts/slider';
  import { onModeChange } from '../scripts/mode';
  import { initClocks, initCopyButtons, initMoreButtons, initToc, initDock } from '../scripts/ui';
  import { initPlayer } from '../scripts/player';
  import { initSkillTrace } from '../scripts/skills';
  initCopyButtons();
  initClocks();
  initPlayer();
  initMoreButtons();
  const resumeRoot = document.querySelector<HTMLElement>('.resume');
  if (resumeRoot) {
    initSkillTrace(resumeRoot);
    initToc(resumeRoot);
    initDock(resumeRoot);
  }
  const root = document.querySelector<HTMLElement>('.resume');
  if (root) {
    void import('../scripts/build').then(({ startBuild, initBuildKeys, RESUME_BUILD }) => {
      initBuildKeys(root, RESUME_BUILD);
      void startBuild(root);
    });
  }
  const slider = document.querySelector<HTMLElement>('[data-mode-slider]');
  if (slider) initSlider(slider);
  // This page is the résumé; picking another mode goes to the home page in that mode.
  onModeChange((mode) => {
    if (mode !== 'recruiter') location.href = '/';
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px var(--gutter);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .mark,
  .nav-link {
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .mark {
    font-size: 0.8rem;
    color: var(--fg);
  }
  .mark span {
    color: var(--fg-faint);
    margin: 0 2px;
  }
  .nav-link {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--fg-dim);
  }
  .nav-link:hover {
    color: var(--fg);
  }
  @media (max-width: 560px) {
    .nav-link {
      display: none;
    }
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>
