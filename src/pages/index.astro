---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ModeSlider from '../components/ModeSlider.astro';
import RecruiterView from '../components/RecruiterView.astro';
import Work from '../components/Work.astro';
import Fork from '../components/Fork.astro';
import MoreWork from '../components/MoreWork.astro';
import ExperienceSection from '../components/Experience.astro';
import Rail from '../components/Rail.astro';
import OpenSource from '../components/OpenSource.astro';
import Activity from '../components/Activity.astro';
import Writing from '../components/Writing.astro';
import Contact from '../components/Contact.astro';
import { profile } from '../content/profile';
---

<Base>
  <header class="site-header">
    <nav class="nav" aria-label="Primary">
      <a class="mark" href="/" aria-label={`${profile.name} — home`}>AS<span>/</span>26</a>
      <a class="nav-link" href="/writing/">Writing</a>
      <a class="nav-link" href="#contact" data-scroll-to="#contact">Contact</a>
    </nav>
    <ModeSlider />
  </header>

  <canvas class="gl-canvas experience-only" data-gl aria-hidden="true"></canvas>
  <Rail />

  <main>
    <Hero />
    <Work />
    <Fork />
    <MoreWork />
    <ExperienceSection />
    <OpenSource />
    <Activity />
    <Writing />
    <RecruiterView />
  </main>
  <Contact />

  <noscript>
    <style>
      .experience-only { display: none !important; }
      .recruiter-only { display: block !important; }
    </style>
  </noscript>
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px var(--gutter);
    pointer-events: none;
  }
  .site-header > :global(*) {
    pointer-events: auto;
  }
  .mark {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--fg);
  }
  .mark span {
    color: var(--fg-faint);
    margin: 0 2px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--fg-dim);
    transition: color 0.3s var(--ease-out);
  }
  .nav-link:hover {
    color: var(--fg);
  }
  :global(:root[data-mode='recruiter']) .nav-link[href='#contact'] {
    display: none;
  }
  @media (max-width: 560px) {
    .nav-link {
      display: none;
    }
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>
