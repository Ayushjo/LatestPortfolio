---
import '../styles/tokens.css';
import '../styles/global.css';
import { profile } from '../content/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.bio.recruiter,
} = Astro.props;

/** Versioned so link-preview caches (X keeps them ~7 days) fetch a new image when it changes. */
const ogImage = new URL('/og-v2.png', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.toString(),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Naya Raipur', addressCountry: 'IN' },
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.twitter],
};
---

<!doctype html>
<html lang="en" data-mode="immersive">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ayush Singh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="AYUSH in silver particles — Ayush Singh, systems engineer" />
    <meta property="og:image:alt" content="AYUSH in silver particles — Ayush Singh, systems engineer" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title="Writing" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;800;900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script is:inline>
      (function () {
        var modes = ['immersive', 'casual', 'recruiter'];
        var m = null;
        try {
          m = localStorage.getItem('mode');
        } catch (e) {}
        if (modes.indexOf(m) === -1) {
          m = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'recruiter' : 'immersive';
        }
        document.documentElement.dataset.mode = m;
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
