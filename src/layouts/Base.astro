---
// Self-hosted fonts (no Google round trips). Each file carries unicode ranges, so only the
// subsets a page actually uses are downloaded.
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/800.css';
import '@fontsource/inter-tight/900.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
// The hero's particle words are drawn in this weight and the tagline in this face: fetch
// them with the HTML instead of when the engine first asks for them.
import heroFont from '@fontsource/inter-tight/files/inter-tight-latin-900-normal.woff2?url';
import taglineFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { profile } from '../content/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.bio.recruiter,
} = Astro.props;

/** Versioned so link-preview caches (X keeps them ~7 days) fetch a new image when it changes. */
const ogImage = new URL('/og-v3.png', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.toString(),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Naya Raipur', addressCountry: 'IN' },
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.twitter],
};
---

<!doctype html>
<html lang="en" data-mode="immersive">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ayush Singh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Ayush Singh, systems engineer — portrait in silver particles" />
    <meta property="og:image:alt" content="Ayush Singh, systems engineer — portrait in silver particles" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title="Writing" href="/rss.xml" />

    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={taglineFont} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var modes = ['immersive', 'casual', 'recruiter'];
        var m = null;
        try {
          m = localStorage.getItem('mode');
        } catch (e) {}
        if (modes.indexOf(m) === -1) {
          m = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'recruiter' : 'immersive';
        }
        document.documentElement.dataset.mode = m;
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
